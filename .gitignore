# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
.venv/
venv/
env/

# Database (local dev only — not for version control)
*.sqlite
*.sqlite3
*.db

# Runtime artifacts — `project_db rebuild` exports proposals here before re-deriving
proposals_backup_*.json

# Financial reconciliation working dir — generated bundles + advisory reports,
# regenerable from the DB via export_financial_bundles.py + reconcile_financials_llm.py
.reconcile_bundles/

# Environment / secrets
.env
*.env.local
secrets/
*.client_secret*.json

# Editor
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Claude local session state (worktrees, launch config, personal overrides) stays
# ignored — but the SHARED project config (skills, hooks, checked-in settings) is
# version-controlled so it propagates. Note: must glob `.claude/*` (not `.claude/`)
# for the negations below to take effect — git can't re-include under an excluded dir.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/
.claude/hooks/__pycache__/

# Node (presentation build only)
node_modules/

# Slide-deck side-project — generated artifacts, not part of the Python package.
# Files stay on disk; un-ignore if the deck should be version-controlled.
presentation/
