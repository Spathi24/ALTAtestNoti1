// =============================================================================
// Project Database — v0.1 Skeleton Model
// =============================================================================
// Goal: minimal canonical entity model with external ID mapping so we can
// unify data from Monday.com, CompanyCam, QuickBooks, and Google Drive.
//
// Design notes:
//   - Every entity that can appear in multiple source systems extends
//     CanonicalEntity and has its own internal UUID.
//   - ExternalId maps a canonical entity to its representation in each
//     source system. This is the "Option B" identity strategy.
//   - Real estate context: Property is its own entity, distinct from Project,
//     since one Property may have many Projects (renovations, sales, etc.)
//     over its lifetime.
//
// Conventions (applied throughout this model):
//   - `-<@>` = composition. The diamond side OWNS the lifecycle of the other:
//     deleting the parent deletes the children. Used for true containment
//     (Project owns its Tasks, an Organization owns its Users, a
//     CanonicalEntity owns its ExternalId mappings, etc.).
//   - `--` = plain association. Both sides reference each other but neither
//     owns the other's lifecycle (Project references a Property, but the
//     Property survives Project deletion).
//   - `immutable` is applied to identity / audit fields that should never
//     change after construction (createdAt, the source-system key triplet
//     on ExternalId).
// =============================================================================

namespace project_db.v01;

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum SourceSystem {
  MONDAY,
  COMPANYCAM,
  QUICKBOOKS,
  GOOGLE_DRIVE,
  INTERNAL
}

enum ProjectStatus {
  PROPOSED,
  ACTIVE,
  ON_HOLD,
  COMPLETED,
  CANCELLED
}

enum LeadStage {
  NEW,
  QUALIFIED,
  PROPOSAL,
  NEGOTIATION,
  WON,
  LOST
}

enum InvoiceStatus {
  DRAFT,
  SENT,
  PARTIAL,
  PAID,
  OVERDUE,
  VOID
}

// Was a free-form String in the original — now constrained so the AI
// assistant doesn't have to guess what "in progress" vs "InProgress"
// vs "wip" means across source systems.
enum TaskStatus {
  TODO,
  IN_PROGRESS,
  BLOCKED,
  DONE,
  CANCELLED
}

// -----------------------------------------------------------------------------
// Canonical base — every multi-source entity inherits from this
// -----------------------------------------------------------------------------

class CanonicalEntity {
  abstract;
  immutable UUID canonicalId;        // internal UUID, generated by DB
  immutable DateTime createdAt;      // never changes after construction
  DateTime updatedAt;
  lazy String notes;
}

// One canonical entity owns many external IDs (one per source system it lives
// in). Composition: when a canonical entity is purged, its mappings go too —
// orphaned mapping rows are meaningless.
//
// Composite key prevents duplicate mappings: the same external key string
// can legitimately appear across systems (Monday board id 12345 and a
// QuickBooks customer id 12345 are unrelated), and even within one system
// across different entity types — so all three columns must match for a
// row to be a duplicate.
class ExternalId {
  immutable SourceSystem source;
  immutable String externalKey;      // the ID in that source system
  lazy String externalUrl;           // deep link back to the source record
  immutable String entityType;       // canonical class name, e.g. "Project"
  DateTime lastSyncedAt;
  lazy String rawPayloadHash;        // detect upstream changes cheaply

  * -<@> 1 CanonicalEntity;

  key { source, externalKey, entityType }
}

// -----------------------------------------------------------------------------
// Org / people
// -----------------------------------------------------------------------------

class Organization {
  isA CanonicalEntity;
  name;
  lazy String legalName;
  lazy String defaultCurrency;
}

// User, Client, Vendor, Property are tenant-scoped — they belong to exactly
// one Organization for their entire life. Composition makes the tenant
// boundary explicit and ensures clean tenant offboarding (drop the org → its
// users/clients/vendors/properties go with it).
class User {
  isA CanonicalEntity;
  email;
  String displayName;
  lazy String role;                  // PM, Sales, Admin, Field, etc.
  lazy Boolean isActive;

  * -<@> 1 Organization;
}

// -----------------------------------------------------------------------------
// CRM-side parties
// -----------------------------------------------------------------------------

class Client {
  isA CanonicalEntity;
  name;
  lazy String email;
  lazy String phone;
  lazy String billingAddress;

  * -<@> 1 Organization;
}

class Vendor {
  isA CanonicalEntity;
  name;
  lazy String email;
  lazy String phone;
  lazy String taxId;
  lazy String paymentTerms;

  * -<@> 1 Organization;
}

// -----------------------------------------------------------------------------
// Real estate
// -----------------------------------------------------------------------------

class Property {
  isA CanonicalEntity;
  String address;
  lazy String shortLabel;            // e.g. "923 Rockland"
  lazy String city;
  lazy String region;
  lazy String postalCode;
  lazy String country;
  lazy String propertyType;          // residential, commercial, mixed, ...
  lazy Float lotSize;
  lazy Integer yearBuilt;

  * -<@> 1 Organization;
}

// -----------------------------------------------------------------------------
// Sales pipeline
// -----------------------------------------------------------------------------

class Lead {
  isA CanonicalEntity;
  lazy String sourceChannel;         // referral, website, walk-in
  LeadStage stage;
  lazy Decimal estimatedValue;
  lazy Date qualifiedAt;

  * -- 0..1 Client;
  * -- 0..1 User owner;
  * -- 0..1 Property;
}

// A Lead converts to AT MOST one Deal, and a Deal originates from at most one
// Lead — never many-from-one. Original `* -- 0..1 Lead` was a multiplicity bug.
class Deal {
  isA CanonicalEntity;
  name;
  Decimal value;
  LeadStage stage;
  lazy Date expectedCloseDate;
  lazy Date actualCloseDate;
  lazy Float probability;

  0..1 -- 0..1 Lead;
  * -- 1 Client;
  * -- 0..1 Property;
  * -- 0..1 User owner;
}

// -----------------------------------------------------------------------------
// Delivery
// -----------------------------------------------------------------------------

// A Deal can spawn multiple Projects (phased contracts), so Project — Deal
// stays * -- 0..1 deliberately.
class Project {
  isA CanonicalEntity;
  name;
  lazy String code;                  // human-readable e.g. "923-ROCK-001"
  ProjectStatus status;
  lazy Date startDate;
  lazy Date endDate;
  lazy Decimal budgetAmount;
  lazy Decimal contractAmount;

  * -- 1 Client;
  * -- 0..1 Deal;                    // came from this won deal
  * -- 0..1 Property;
  * -- 0..1 User projectManager;
}

// Tasks and DailyLogs are owned by their Project — if the project is purged
// from the canonical layer they go too. Compositions also make the
// "every task has exactly one project" lifecycle invariant enforceable.
class Task {
  isA CanonicalEntity;
  title;
  TaskStatus status;
  lazy Date dueDate;
  lazy Date completedAt;

  * -<@> 1 Project;
  * -- 0..1 User assignee;
}

class DailyLog {
  isA CanonicalEntity;
  Date logDate;
  lazy String summary;

  * -<@> 1 Project;
  * -- 0..1 User author;
}

// -----------------------------------------------------------------------------
// Finance (minimal in v0.1 — full P&L comes in full model)
// -----------------------------------------------------------------------------

// Note: Invoice is intentionally NOT a composition of Project. Financial
// records must survive operational deletions (compliance / audit).
class Invoice {
  isA CanonicalEntity;
  immutable String number;
  Decimal amount;
  immutable Date issueDate;
  lazy Date dueDate;
  InvoiceStatus status;

  * -- 1 Project;
  * -- 1 Client;
}

// -----------------------------------------------------------------------------
// Documents (references — actual files stay in Drive / CompanyCam / etc.)
// -----------------------------------------------------------------------------

// Document carries optional FKs to several possible "attachables". A cleaner
// long-term shape is a polymorphic Attachable abstraction, but for v0.1 the
// fan-out of optionals is more readable and translates 1:1 to SQL nullable
// FKs.
class Document {
  isA CanonicalEntity;
  name;
  lazy String mimeType;
  String url;                        // canonical URL to the file
  lazy String storageRef;            // source-specific reference

  * -- 0..1 Project;
  * -- 0..1 Deal;
  * -- 0..1 Client;
}
