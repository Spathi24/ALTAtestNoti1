# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored -- NEVER commit it, NEVER put a real secret here
# in .env.example.  This template ships with blank placeholders only.
#
# None of these are required for `init-db`; each connector needs its own.

# --- Database -----------------------------------------------------------
# sqlite for local dev, Postgres for production.  Use an ABSOLUTE path so
# the same DB is used regardless of which directory you run from.
PROJECT_DB_URL=sqlite:////absolute/path/to/project-db/project_db.sqlite
# PROJECT_DB_URL=postgresql+psycopg://user:pass@host:5432/project_db

# --- Monday.com (required for `sync monday`) ----------------------------
# Monday > avatar > Admin > API.  Treat as a password.
MONDAY_API_TOKEN=

# --- Google Drive (required for `sync GOOGLE_DRIVE`) --------------------
# Path to the credential JSON: an OAuth Desktop client secret OR a
# service-account key (auto-detected).  Run `project_db gdrive-auth`
# once for the OAuth flow.
GDRIVE_SA_KEY_PATH=
GDRIVE_IMPERSONATE=              # service-account flow only (Workspace user)
GDRIVE_TOKEN_PATH=               # OAuth flow only; auto-created if unset
GDRIVE_ROOT_FOLDER=root          # Drive folder id to crawl

# --- QuickBooks (connector code complete; live run deferred) ------------
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ACCESS_TOKEN=

# --- LLM provider (Phase 3) --------------------------------------------
# Resolver order: LLM_PROVIDER -> anthropic-if-key-present -> mock.
LLM_PROVIDER=mock                # mock | anthropic | openai-compatible

# anthropic provider:
ANTHROPIC_API_KEY=

# openai-compatible provider -- Ollama, vLLM, llama.cpp, LM Studio, OpenAI.
# Point BASE_URL at the local server (or the Mac mini when it ships).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:3b
OPENAI_API_KEY=EMPTY             # most local servers ignore auth
OPENAI_TIMEOUT=600               # seconds; bump for slow CPU inference

# --- CompanyCam (deferred per STRATEGY.md) -----------------------------
# COMPANYCAM_API_TOKEN=
