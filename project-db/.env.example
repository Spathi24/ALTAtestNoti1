# Copy to .env and fill in. None of these are required for `init-db`,
# but each connector needs its own credentials.

# Database — sqlite for local dev, Postgres for everything else.
# Use an ABSOLUTE path so the same DB is used regardless of which directory
# you run `project_db` from. (Relative `./project_db.sqlite` would resolve
# differently depending on whether you're in project-db/ or its parent.)
PROJECT_DB_URL=sqlite:///C:/Users/nsaro/Documents/VScode/ALTAtest/project-db/project_db.sqlite
# PROJECT_DB_URL=postgresql+psycopg://user:pass@host:5432/project_db

