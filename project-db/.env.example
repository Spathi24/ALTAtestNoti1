# Copy to .env and fill in. None of these are required for `init-db`,
# but each connector needs its own credentials.

# Database — sqlite for local dev, Postgres for everything else.
# For Postgres on Supabase / Neon use the connection string they give you.
PROJECT_DB_URL=sqlite:///./project_db.sqlite
# PROJECT_DB_URL=postgresql+psycopg://user:pass@host:5432/project_db

# Monday.com
MONDAY_API_TOKEN=

# CompanyCam (v0.2)
COMPANYCAM_API_TOKEN=

# QuickBooks (v0.2)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Google Drive (v0.2) — path to service-account JSON
GOOGLE_CREDENTIALS_PATH=

# Anthropic — for the AI assistant + LLM proposal layer.
ANTHROPIC_API_KEY=
# LLM_PROVIDER: mock | anthropic | openai-compatible (default: anthropic if key set)
LLM_PROVIDER=anthropic
# Proposal-grade ("deep") model — analytical work like `propose`.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Fast/cheap model for the `ask` LLM fallback (summarization-grade).
# Defaults to claude-haiku-4-5 when unset.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
